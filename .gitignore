# ============================================================
#  AI Interview Practice & GD Analyzer — Root .gitignore
# ============================================================

# --- Environment Variables (NEVER commit real .env files) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env

# --- Node Modules ---
node_modules/
backend/node_modules/
frontend/node_modules/

# --- Build Outputs ---
frontend/dist/
frontend/build/
backend/dist/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE / Editor ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Misc ---
.cache/
coverage/
*.tsbuildinfo
